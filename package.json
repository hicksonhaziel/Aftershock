{
  "name": "aftershock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test packages/*/test/*.test.ts apps/cli/test/*.test.ts",
    "check": "pnpm typecheck && pnpm test",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "rpc:check": "tsx apps/cli/src/index.ts rpc-check",
    "stream:check": "tsx apps/cli/src/stream-check.ts",
    "capture": "tsx apps/cli/src/capture.ts",
    "capture:verify": "tsx apps/cli/src/verify-capture.ts"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
