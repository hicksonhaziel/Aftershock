{
  "name": "aftershock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p apps/workbench/tsconfig.json",
    "test": "tsx --test packages/*/test/*.test.ts apps/cli/test/*.test.ts apps/workbench/test/*.test.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm test",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "rpc:check": "tsx apps/cli/src/index.ts rpc-check",
    "stream:check": "tsx apps/cli/src/stream-check.ts",
    "capture": "tsx apps/cli/src/capture.ts",
    "capture:verify": "tsx apps/cli/src/verify-capture.ts",
    "reference:check": "tsx apps/cli/src/reference-check.ts",
    "reconnect:check": "tsx apps/cli/src/reconnect-check.ts",
    "compatibility:check": "tsx apps/cli/src/compatibility-check.ts",
    "db:up": "tsx apps/cli/src/database.ts up",
    "db:check": "tsx apps/cli/src/database.ts check",
    "db:down": "tsx apps/cli/src/database.ts down",
    "capture:export-replay": "tsx apps/cli/src/export-replay.ts",
    "format:check": "node scripts/check-format.mjs",
    "capture:normalize": "tsx apps/cli/src/normalize-trades.ts",
    "build:regression": "node scripts/build-regression.mjs",
    "campaign": "tsx apps/cli/src/campaign.ts",
    "regression:test": "node .aftershock/build/regression.mjs test",
    "regression:reproduce": "node .aftershock/build/regression.mjs reproduce",
    "test:regression": "pnpm build:regression && tsx --test packages/runner/integration/*.test.ts",
    "external:state-check": "tsx apps/cli/src/external-state-check.ts",
    "campaign:recovery": "tsx apps/cli/src/recovery-campaign.ts",
    "reduce": "tsx apps/cli/src/case-tools.ts reduce",
    "export": "tsx apps/cli/src/case-tools.ts export",
    "compare": "tsx apps/cli/src/case-tools.ts compare",
    "control": "tsx apps/cli/src/control.ts",
    "api": "tsx apps/api/src/index.ts",
    "worker": "tsx apps/worker/src/index.ts",
    "test:control": "pnpm build:regression && tsx --test packages/control/integration/*.test.ts",
    "build:workbench": "pnpm --filter @aftershock/workbench build"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
