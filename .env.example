# Copy to .env locally. Never commit actual endpoints or credentials.
# Issued RPC URL, including account authentication if required by Solami.
SOLAMI_RPC_URL=
# Optional until the first transport is validated against the issued account.
SOLAMI_STREAM_URL=
SOLAMI_STREAM_TOKEN=
AFTERSHOCK_DATA_DIR=.aftershock

# Standard API key; stream probe uses it if SOLAMI_STREAM_TOKEN is empty.
SOLAMI_API_KEY=

# Local PostgreSQL is managed separately with pnpm db:up.
# Its generated password lives in ignored .aftershock/dev-db.env.
# Do not set a production DATABASE_URL for consumer tests.
